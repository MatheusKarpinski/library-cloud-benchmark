# Copie este arquivo para ".env" e ajuste os valores. O ".env" NUNCA deve ser versionado.
# Os valores abaixo são apenas demonstrativos e só servem para o banco LOCAL.

# --- Usados pelo docker-compose.yml (criam o banco local) ---
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=troque-esta-senha-local

# --- Usados pela aplicação (DB_PASSWORD deve ser igual a POSTGRES_PASSWORD no ambiente local) ---
DB_URL=jdbc:postgresql://localhost:5432/library
DB_USER=library
DB_PASSWORD=troque-esta-senha-local

# --- Pool de conexões (por instância da aplicação) ---
DB_POOL_MAX=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=5000

# --- Porta HTTP da API em container ---
SERVER_PORT=8080
